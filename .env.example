# Keys requeridas. NO versionar valores reales: viven solo en .env.local (gitignored)
# y en las variables de entorno de Supabase/AWS.

# --- Cliente (Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# --- Portal ---
# Pública (pk_): va al cliente. Secreta (sk_): solo backend, nunca al cliente.
VITE_PORTAL_KEY=
PORTAL_SECRET=

# --- Backend (Supabase Edge Function) ---
# Se configuran como variables de entorno de la Edge Function, NO en el cliente.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
PORTAL_SECRET_BACKEND=

# --- AWS (Bedrock) ---
# Solo en variables de entorno de la Edge Function (Supabase).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Modelo por definir; candidato DeepSeek v3.2.
BEDROCK_MODEL_ID=
